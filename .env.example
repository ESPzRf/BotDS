# Токен бота из https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_TOKEN_HERE

# Необязательно: ID сервера для мгновенной синхронизации слэш-команд.
# Если пусто — команды синхронизируются глобально (может занять до часа).
GUILD_ID=

# Необязательно: путь к файлу SQLite (по умолчанию data/bot.db).
# Используется, только если DATABASE_URL пуст.
DB_PATH=data/bot.db

# Необязательно: PostgreSQL. Если заполнено — SQLite игнорируется.
# Формат: postgresql://user:password@host:5432/dbname
# Нужен пакет asyncpg: pip install -r requirements-postgres.txt
DATABASE_URL=

# Необязательно: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Необязательно: файл логов (например logs/bot.log). Пусто или none — только консоль.
LOG_FILE=

# --- Веб-панель (python dashboard.py) ---------------------------------
# OAuth2-приложение: Developer Portal -> OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Секрет для серверных сессий (любая длинная случайная строка)
DASHBOARD_SECRET=
# Публичный адрес панели; должен совпадать с Redirect URI в Developer Portal
DASHBOARD_BASE_URL=http://127.0.0.1:8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

